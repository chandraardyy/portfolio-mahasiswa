:root {
  --bg: #0b1120;
  --bg-soft: #111827;
  --panel: #172033;
  --panel-2: #1d2940;
  --primary: #7c3aed;
  --secondary: #4f46e5;
  --accent: #ec4899;
  --text: #edf2ff;
  --muted: #a5b4cf;
  --line: rgba(255, 255, 255, 0.08);
  --shadow: rgba(124, 58, 237, 0.25);
  --white: #ffffff;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: "Poppins", sans-serif;
  background: linear-gradient(135deg, #0b1120 0%, #111827 45%, #0f172a 100%);
  color: var(--text);
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}

img {
  max-width: 100%;
  display: block;
}

button,
input,
textarea {
  font: inherit;
}

.container {
  width: min(1120px, calc(100% - 2rem));
  margin: 0 auto;
}

.section-title {
  text-align: center;
  margin-bottom: 2.5rem;
}

.section-title p {
  color: #9ca3af;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.75rem;
  margin-bottom: 0.5rem;
}

.section-title h2 {
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 800;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* Header */
.header {
  position: sticky;
  top: 0;
  z-index: 1000;
  backdrop-filter: blur(12px);
  background: rgba(11, 17, 32, 0.7);
  border-bottom: 1px solid var(--line);
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80px;
}

.logo {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-weight: 700;
  font-size: 1.2rem;
}

.logo-mark {
  width: 32px;
  height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  box-shadow: 0 10px 24px var(--shadow);
}

.nav-menu {
  display: flex;
  align-items: center;
  gap: 1.7rem;
  list-style: none;
}

.nav-menu a {
  color: var(--muted);
  font-weight: 500;
  transition: 0.3s ease;
  position: relative;
}

.nav-menu a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -6px;
  width: 0;
  height: 2px;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  transition: 0.3s ease;
}

.nav-menu a:hover::after,
.nav-menu a:hover {
  color: var(--white);
}

.nav-menu a:hover::after {
  width: 100%;
}

.menu-toggle {
  display: none;
  background: transparent;
  border: none;
  cursor: pointer;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  border: 1px solid var(--line);
}

.menu-toggle span {
  display: block;
  width: 18px;
  height: 2px;
  background: var(--white);
  margin: 4px auto;
  border-radius: 2px;
}

/* Hero */
.hero {
  padding: 5rem 0 4rem;
}

.hero-content {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  align-items: center;
  gap: 2rem;
}

.eyebrow {
  display: inline-block;
  padding: 0.45rem 0.9rem;
  border-radius: 999px;
  background: rgba(124, 58, 237, 0.12);
  color: #d7dfff;
  border: 1px solid rgba(124, 58, 237, 0.35);
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 1rem;
}

.hero-text h1 {
  font-size: clamp(2.6rem, 6vw, 5rem);
  line-height: 1.05;
  margin-bottom: 1rem;
  font-weight: 800;
}

.hero-text h1 span {
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.subtitle {
  font-size: clamp(1.1rem, 2vw, 1.5rem);
  color: var(--muted);
  margin-bottom: 1rem;
}

.desc {
  max-width: 620px;
  color: var(--muted);
  font-size: 1.02rem;
  margin-bottom: 2rem;
}

.cta {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

.btn {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 0.5rem;
  padding: 0.9rem 1.5rem;
  border-radius: 14px;
  font-weight: 600;
  transition: 0.3s ease;
  border: 1px solid transparent;
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: var(--white);
  box-shadow: 0 18px 35px var(--shadow);
}

.btn-primary:hover {
  transform: translateY(-3px);
}

.btn-secondary {
  background: transparent;
  border-color: rgba(124, 58, 237, 0.5);
  color: var(--white);
}

.btn-secondary:hover {
  background: rgba(124, 58, 237, 0.08);
}

.full {
  width: 100%;
}

.hero-visual {
  display: flex;
  justify-content: center;
}

.profile-card {
  position: relative;
  width: min(360px, 80vw);
  aspect-ratio: 1;
  border-radius: 30px;
  background: transparent;
  border: none;
  display: grid;
  place-items: center;
  box-shadow: none;
}

.profile-circle {
  width: 320px;
  height: 320px;
  border-radius: 50%;
  overflow: hidden;
  border: none;
  background: transparent;
  box-shadow: none;
  padding: 0;
}
.profile-circle img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: 50%;
}

.badge {
  position: absolute;
  right: 1rem;
  bottom: 1rem;
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 0.55rem 0.9rem;
  color: var(--muted);
  font-size: 0.75rem;
  font-weight: 500;
}

/* About */
.about {
  padding: 4.5rem 0;
}

.about-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 2rem;
  align-items: start;
}

.about-text p {
  color: var(--muted);
  margin-bottom: 1rem;
  font-size: 1.02rem;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1rem;
  margin-top: 2rem;
}

.stat-box {
  background: rgba(17, 24, 39, 0.9);
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 1.3rem 1rem;
  text-align: center;
}

.stat-box strong {
  display: block;
  font-size: clamp(1.8rem, 3vw, 2.5rem);
  margin-bottom: 0.3rem;
}

.stat-box span {
  color: var(--muted);
  font-size: 0.86rem;
}

.about-cards {
  display: grid;
  gap: 1rem;
}

.mini-card {
  background: rgba(17, 24, 39, 0.9);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 1.5rem;
  transition: 0.3s ease;
}

.mini-card:hover {
  transform: translateY(-4px);
  border-color: rgba(124, 58, 237, 0.6);
}

.mini-card i {
  font-size: 1.7rem;
  color: var(--primary);
  margin-bottom: 0.8rem;
}

.mini-card h3 {
  margin-bottom: 0.4rem;
  font-size: 1.05rem;
}

.mini-card p {
  color: var(--muted);
}

/* Skills */
.skills {
  padding: 4.5rem 0;
}

.skills-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(200px, 1fr));
  gap: 1.2rem;
}

.skill-card {
  background: rgba(17, 24, 39, 0.9);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 1.5rem;
  transition: 0.3s ease;
}

.skill-card:hover {
  transform: translateY(-6px);
  border-color: rgba(124, 58, 237, 0.6);
}

.skill-card h3 {
  margin-bottom: 1rem;
  font-size: 1.15rem;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.tags span {
  display: inline-block;
  padding: 0.5rem 0.8rem;
  border-radius: 999px;
  background: rgba(124, 58, 237, 0.12);
  border: 1px solid rgba(124, 58, 237, 0.35);
  color: #d9d5ff;
  font-size: 0.8rem;
}

/* Projects */
.projects {
  padding: 4.5rem 0;
}

.project-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(230px, 1fr));
  gap: 1.5rem;
}

.project-card {
  background: rgba(17, 24, 39, 0.9);
  border: 1px solid var(--line);
  border-radius: 22px;
  overflow: hidden;
  transition: 0.3s ease;
}

.project-card:hover {
  transform: translateY(-8px);
  border-color: rgba(124, 58, 237, 0.8);
}

.project-thumb {
  height: 180px;
  display: grid;
  place-items: center;
  font-size: 3rem;
  color: var(--white);
}

.thumb-one {
  background: linear-gradient(135deg, #7c3aed, #4f46e5);
}

.thumb-two {
  background: linear-gradient(135deg, #2563eb, #0ea5e9);
}

.thumb-three {
  background: linear-gradient(135deg, #ec4899, #8b5cf6);
}

.project-body {
  padding: 1.5rem;
}

.project-body h3 {
  margin-bottom: 0.7rem;
  font-size: 1.2rem;
}

.project-body p {
  color: var(--muted);
  margin-bottom: 1rem;
}

.tech {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1rem;
}

.tech span {
  padding: 0.45rem 0.75rem;
  border-radius: 999px;
  font-size: 0.75rem;
  background: rgba(124, 58, 237, 0.12);
  border: 1px solid rgba(124, 58, 237, 0.3);
  color: #d9d5ff;
}

.project-links {
  display: flex;
  gap: 0.75rem;
}

.project-links a {
  flex: 1;
  text-align: center;
  padding: 0.75rem 0.8rem;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: var(--white);
  font-weight: 600;
  transition: 0.3s ease;
}

.project-links a:hover {
  transform: translateY(-2px);
}

/* Contact */
.contact {
  padding: 4.5rem 0;
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 0.9fr;
  gap: 1.5rem;
}

.contact-form,
.contact-info {
  background: rgba(17, 24, 39, 0.9);
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: 1.5rem;
}

.form-group {
  margin-bottom: 1rem;
}

.form-group input,
.form-group textarea {
  width: 100%;
  border: 1px solid var(--line);
  background: rgba(11, 17, 32, 0.6);
  color: var(--white);
  border-radius: 14px;
  padding: 0.9rem 1rem;
  outline: none;
  transition: 0.3s ease;
}

.form-group input:focus,
.form-group textarea:focus {
  border-color: rgba(124, 58, 237, 0.9);
  box-shadow: 0 0 0 4px rgba(124, 58, 237, 0.12);
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 1.1rem;
}

.info-item {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
}

.info-item i {
  font-size: 1.4rem;
  color: var(--primary);
  margin-top: 0.3rem;
}

.info-item h4 {
  margin-bottom: 0.2rem;
}

.info-item p {
  color: var(--muted);
}

.socials {
  display: flex;
  gap: 0.8rem;
  margin-top: 0.5rem;
}

.socials a {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: rgba(124, 58, 237, 0.1);
  border: 1px solid rgba(124, 58, 237, 0.35);
  transition: 0.3s ease;
}

.socials a:hover {
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  transform: translateY(-3px);
}

/* Footer */
.footer {
  padding: 2rem 0;
  text-align: center;
  color: var(--muted);
  border-top: 1px solid var(--line);
}

.footer i {
  color: #ff5d8f;
}

/* Scroll Top */
.scroll-top {
  position: fixed;
  right: 20px;
  bottom: 20px;
  width: 48px;
  height: 48px;
  border: none;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--secondary));
  color: var(--white);
  cursor: pointer;
  display: none;
  place-items: center;
  box-shadow: 0 18px 35px rgba(124, 58, 237, 0.35);
  z-index: 999;
}

/* Responsive */
@media (max-width: 900px) {
  .hero-content,
  .about-grid,
  .contact-grid {
    grid-template-columns: 1fr;
  }

  .skills-grid {
    grid-template-columns: repeat(2, minmax(200px, 1fr));
  }

  .project-grid {
    grid-template-columns: repeat(2, minmax(220px, 1fr));
  }
}

@media (max-width: 700px) {
  .menu-toggle {
    display: block;
  }

  .nav-menu {
    position: absolute;
    top: 80px;
    left: 1rem;
    right: 1rem;
    display: none;
    flex-direction: column;
    background: rgba(11, 17, 32, 0.96);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1rem;
  }

  .nav-menu.active {
    display: flex;
  }

  .skills-grid,
  .project-grid,
  .stats {
    grid-template-columns: 1fr;
  }

  .cta {
    flex-direction: column;
  }

  .btn {
    width: 100%;
  }
}
